{
  "name": "chubasco",
  "productName": "Chubasco",
  "version": "1.0.0",
  "description": "Alarma de lluvia de escritorio: radar en tiempo real, previsión a corto plazo y avisos cuando se acerca la lluvia.",
  "main": "src/main/main.js",
  "author": "lalesena",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/lalesena/chubasco.git"
  },
  "private": true,
  "config": {
    "operaProxy": "https://chubasco-opera.lalesena-48d.workers.dev"
  },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "build:web": "node web/build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "electron-updater": "^6.8.9",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.13.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsfive": "^0.4.2",
    "mdb-reader": "^3.2.0",
    "polygon-clipping": "^0.15.7"
  },
  "build": {
    "appId": "io.github.lalesena.chubasco",
    "productName": "Chubasco",
    "copyright": "© 2026 lalesena",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "!**/*.map"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.weather",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert",
        "NSLocationUsageDescription": "Chubasco usa tu ubicación para vigilar la lluvia allí donde estés (ubicación «Aquí»).",
        "NSLocationWhenInUseUsageDescription": "Chubasco usa tu ubicación para vigilar la lluvia allí donde estés (ubicación «Aquí»)."
      }
    },
    "dmg": {
      "title": "Chubasco ${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chubasco",
      "artifactName": "Chubasco-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lalesena",
        "repo": "chubasco",
        "releaseType": "release"
      }
    ]
  }
}
